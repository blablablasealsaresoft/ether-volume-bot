# ether-volume-bot .env template
# Copy this file to ".env" in the same folder and fill in the values.
# NEVER commit the real .env or paste it into any AI chat - it holds your private key.

# The token the bot trades volume against (contract address, 0x...)
TARGET_TOKEN_ADDRESS=0x_YOUR_TARGET_TOKEN_CONTRACT_ADDRESS

# RPC endpoints - public ones below work; paid endpoints (Alchemy/Infura/Ankr) are faster
# Ethereum mainnet
ETH_RPC_ENDPOINT=https://eth.llamarpc.com
# BNB Smart Chain
BSC_RPC_ENDPOINT=https://bsc-dataseed.binance.org
# Ethereum Sepolia testnet (only used when testVersion = true in config.ts)
ETH_SEPOLIA_RPC_ENDPOINT=https://rpc.sepolia.org/api
# MEV-protection / private relay endpoint used to confirm transactions on mainnet
MEV_BLOCK_RPC_ENDPOINT=https://YOUR_MEV_PROTECTION_RPC

# Robinhood Chain (Arbitrum Orbit L2, chainId 4663) - only needed if config.ts CHAINID = ChainId.Robinhood
# Official public endpoint (rate-limited): https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_ENDPOINT=https://rpc.mainnet.chain.robinhood.com
# Fee tier of your token's Uniswap V3 pool on Robinhood Chain.
# Leave 0 to auto-detect the pool's fee tier (recommended - Pons V1 launches use 10000).
ROBINHOOD_POOL_FEE=0
# Slippage protection, in basis points: max price movement allowed vs the quoted
# output before the swap reverts instead of executing. 1000 = 10% (default).
# Lower = safer but more likely to revert on volatile launchpad tokens.
ROBINHOOD_SLIPPAGE_BPS=1000

# Wallet - the bot funds sub-wallets from this one
ETH_BASE_WALLET_ADDRESS=
ETH_BASE_WALLET_PRIVATE_KEY=